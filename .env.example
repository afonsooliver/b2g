# Banco (SQLite). No Railway, aponte para um volume persistente, ex.: /data/fastgov.db
DB_PATH=data/fastgov.db

# PNCP
PNCP_MODALIDADES=4,8,9,1,6
PNCP_TAM_PAGINA=1000

# ComprasNet / SERPRO (detalhamento sob demanda)
COMPRASNET_BASE=https://cnetmobile.estaleiro.serpro.gov.br
# Token estático (tem prioridade sobre o autenticador)
# COMPRASNET_TOKEN=eyJ...
# Fonte remota do token no modo debug (instância produtiva / fastgov2)
COMPRASNET_TOKEN_URL=https://fastgov2.up.railway.app/token/?tipo=token
DETALHE_WORKERS=6

# Autenticador
# Default inicial do modo: debug = NÃO EM_PRODUCAO (o modo é alterável em /ui/admin.html e persiste)
EM_PRODUCAO=false
COMPRASNET_VERIFY_SSL=false
# COMPRASNET_SESSAO_ID=<id da sessão do fornecedor para tokenInicial>
AUTH_INTERVALO_OK=300
AUTH_INTERVALO_FALHA=5
